{
  "manifest_version": 3,
  "name": "Corner Harbor",
  "version": "0.1.0",
  "description": "Overlays content at the corner on the current page",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Corner Harbor" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}